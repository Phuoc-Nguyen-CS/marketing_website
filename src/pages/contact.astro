---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';

// Pull the base URL from the environment config (Cloudflare R2 Bucket)
const assetBaseUrl = import.meta.env.PUBLIC_ASSET_URL || '';
const sampleImageSrc = `${assetBaseUrl}/photography/1.jpg`;
---

<Layout title="Contact | Troy | Multimedia & Backend">
  <main class="min-h-screen bg-[#0a0a0a] text-white flex flex-col selection:bg-white selection:text-black">
    <!-- Split Screen Layout Container -->
    <div class="flex-1 grid grid-cols-1 md:grid-cols-2 w-full min-h-screen" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
      
      <!-- Left Side: Cloudflare Photography Image with Blending Gradient -->
      <div class="relative min-h-[50vh] md:min-h-screen overflow-hidden border-r border-white/10">
        <img 
          src={sampleImageSrc} 
          alt="Contact proof-of-concept visual" 
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
        <!-- Linear gradient overlay blending the visual into the #0a0a0a dark background -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/20 to-transparent pointer-events-none"></div>
        <div class="absolute bottom-12 left-12 right-12 z-10">
          <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-neutral-400 mb-2 block">Featured Capture</span>
          <p class="text-xl font-bold tracking-tight text-white uppercase">Mountain Silence</p>
          <p class="text-xs text-neutral-400 font-light mt-1">Served directly from Cloudflare R2 bucket.</p>
        </div>
      </div>

      <!-- Right Side: Form Container (Centered and padded) -->
      <div class="flex flex-col justify-center px-6 py-20 md:px-16 lg:px-24">
        <!-- Header (Muted Decorative Label Removed) -->
        <header class="mb-10">
          <h1 class="text-5xl md:text-6xl font-black tracking-tighter leading-none uppercase text-transparent bg-clip-text bg-gradient-to-r from-white via-white to-neutral-500 mb-4">
            Let's start <br/>something.
          </h1>
          <p class="text-sm md:text-base text-neutral-400 max-w-md font-light leading-relaxed">
            Fill out the form below to initiate booking details, request quotes, or general inquiries.
          </p>
        </header>

        <!-- Glassmorphism Form Container -->
        <div class="bg-[#171717]/60 border border-white/10 rounded-[24px] p-8 shadow-2xl shadow-black/50 backdrop-blur-[12px] flex flex-col gap-6">
          <form class="space-y-6 flex flex-col gap-1" action="#" method="POST" id="contact-form" novalidate>
            
            <!-- Full Name (Required) -->
            <div class="flex flex-col">
              <label for="name" class="block text-xs uppercase tracking-wider text-white/60 mb-2">Full Name *</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                placeholder="John Doe"
                class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-[12px] text-sm text-white focus:border-white focus:outline-none placeholder-neutral-600 transition-colors duration-300 box-border"
              />
              <span id="name-error" class="text-red-500 text-xs font-mono hidden mt-1">Please enter your full name.</span>
            </div>

            <!-- Email Address (Required) -->
            <div class="flex flex-col">
              <label for="email" class="block text-xs uppercase tracking-wider text-white/60 mb-2">Email Address *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="john@example.com"
                class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-[12px] text-sm text-white focus:border-white focus:outline-none placeholder-neutral-600 transition-colors duration-300 box-border"
              />
              <span id="email-error" class="text-red-500 text-xs font-mono hidden mt-1">Please enter a valid email address.</span>
            </div>

            <!-- Subject Dropdown -->
            <div class="flex flex-col">
              <label for="subject" class="block text-xs uppercase tracking-wider text-white/60 mb-2">Subject</label>
              <select 
                id="subject" 
                name="subject" 
                class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-[12px] text-sm text-white focus:border-white focus:outline-none transition-colors duration-300 box-border"
              >
                <option value="General Inquiry" class="bg-[#171717]">General Inquiry</option>
                <option value="Quote Request" class="bg-[#171717]">Quote Request</option>
                <option value="Support" class="bg-[#171717]">Support</option>
              </select>
            </div>

            <!-- Message (Required, 5-row height) -->
            <div class="flex flex-col">
              <label for="message" class="block text-xs uppercase tracking-wider text-white/60 mb-2">Message *</label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required 
                placeholder="Tell me about your project, timeline, and vision..."
                class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-[12px] text-sm text-white focus:border-white focus:outline-none placeholder-neutral-600 transition-colors duration-300 resize-none box-border"
              ></textarea>
              <span id="message-error" class="text-red-500 text-xs font-mono hidden mt-1">Please write your message.</span>
            </div>

            <!-- Submission Status Banner -->
            <div id="form-success" class="bg-emerald-950/40 border border-emerald-800 text-emerald-400 px-4 py-3 rounded text-sm font-mono hidden">
              ✓ Thank you! Your message has been sent successfully.
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full px-4 py-3 bg-white text-black font-semibold text-xs uppercase tracking-widest rounded-[12px] hover:bg-neutral-200 transition-transform duration-200 cursor-pointer active:scale-[0.98]"
            >
              Send Inquiry →
            </button>
          </form>
        </div>
      </div>

    </div>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('contact-form') as HTMLFormElement;
      if (!form) return;

      const nameInput = document.getElementById('name') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const messageInput = document.getElementById('message') as HTMLTextAreaElement;

      const nameError = document.getElementById('name-error');
      const emailError = document.getElementById('email-error');
      const messageError = document.getElementById('message-error');
      const successBanner = document.getElementById('form-success');

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        let isValid = true;

        // Reset errors and banner
        nameError?.classList.add('hidden');
        emailError?.classList.add('hidden');
        messageError?.classList.add('hidden');
        successBanner?.classList.add('hidden');

        // Name Validation
        if (!nameInput.value.trim()) {
          nameError?.classList.remove('hidden');
          isValid = false;
        }

        // Email Validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
          emailError?.classList.remove('hidden');
          isValid = false;
        }

        // Message Validation
        if (!messageInput.value.trim()) {
          messageError?.classList.remove('hidden');
          isValid = false;
        }

        if (isValid) {
          successBanner?.classList.remove('hidden');
          form.reset();
        }
      });
    });
  </script>
</Layout>
