---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';

// Pull the base URL from the environment config (Cloudflare R2 Bucket)
const assetBaseUrl = import.meta.env.PUBLIC_ASSET_URL || '';
const profileImg = `${assetBaseUrl}/photography/2.jpg`;
const actionImg1 = `${assetBaseUrl}/photography/3.jpg`;
const actionImg2 = `${assetBaseUrl}/photography/4.jpg`;
---

<Layout title="Who is Troy? | Multimedia & Backend">
  <main class="min-h-screen bg-neutral-950 text-neutral-100 pt-32 pb-24 px-6 md:px-16 selection:bg-white selection:text-black">
    
    <!-- Hero / Profile Intro Split -->
    <header class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center mb-24 md:mb-32">
      <!-- Intro Text (7 Columns) -->
      <div class="lg:col-span-7">
        <span class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-500 mb-4 block">About the Producer</span>
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter leading-[0.85] uppercase text-white mb-8">
          Who is <br/> [ Troy ]?
        </h1>
        <p class="text-xl md:text-2xl text-neutral-300 font-light leading-relaxed mb-6">
          A SoCal based multimedia producer and backend engineer focused on creating clean, professional visuals and scalable architectures for brands.
        </p>
        <p class="text-base text-neutral-400 font-light leading-relaxed max-w-2xl">
          Bridging the gap between creative visual media and solid engineering design. I build high-performance systems and capture key moments with equal precision.
        </p>
      </div>

      <!-- Profile Image (5 Columns) -->
      <div class="lg:col-span-5 relative aspect-[4/5] overflow-hidden rounded-xl bg-neutral-900 border border-neutral-800/80 shadow-2xl shadow-black/80">
        <img 
          src={profileImg} 
          alt="Troy - Profile portrait" 
          class="absolute inset-0 h-full w-full object-cover grayscale hover:grayscale-0 transition-all duration-700 ease-in-out"
          loading="eager"
        />
        <div class="absolute bottom-6 left-6 z-10">
          <span class="text-[9px] font-mono px-3 py-1 border border-white/10 rounded text-white bg-black/40 backdrop-blur-sm">Studio Profile</span>
        </div>
      </div>
    </header>

    <!-- Narrative & Asymmetric Image Grid -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-32 border-t border-neutral-900 pt-16">
      
      <!-- Philosophy (4 Columns) -->
      <div class="lg:col-span-4 space-y-8">
        <div>
          <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-neutral-500 mb-4">Philosophy</h2>
          <p class="text-base text-neutral-300 font-light leading-relaxed">
            I believe good visual and structural work is not about doing more. It's about doing it right. It is about understanding the core essence of a brand or product and tailoring the execution to that story.
          </p>
        </div>
        <div>
          <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-neutral-500 mb-4">Focus Areas</h2>
          <ul class="space-y-2 text-sm text-neutral-400 font-mono">
            <li>+ Editorial & Brand Photography</li>
            <li>+ Cinematic Video Production</li>
            <li>+ API & High-Performance Backends</li>
            <li>+ System Architecture Design</li>
          </ul>
        </div>
      </div>

      <!-- Left Action Photo (4 Columns) -->
      <div class="lg:col-span-4 relative aspect-[3/4] overflow-hidden rounded-xl bg-neutral-900 border border-neutral-800/50 shadow-lg">
        <img 
          src={actionImg1} 
          alt="Capturing architectural geometry" 
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />
        <div class="absolute bottom-6 left-6">
          <p class="text-xs font-mono text-white tracking-widest uppercase">Urban Reflection</p>
          <span class="text-[9px] text-neutral-400 block font-mono">1/250s f/4.0 ISO 200</span>
        </div>
      </div>

      <!-- Right Action Photo (4 Columns) -->
      <div class="lg:col-span-4 relative aspect-[3/4] overflow-hidden rounded-xl bg-neutral-900 border border-neutral-800/50 shadow-lg lg:mt-12">
        <img 
          src={actionImg2} 
          alt="Structured shadows capture" 
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />
        <div class="absolute bottom-6 left-6">
          <p class="text-xs font-mono text-white tracking-widest uppercase">Structured Shadows</p>
          <span class="text-[9px] text-neutral-400 block font-mono">1/500s f/2.8 ISO 100</span>
        </div>
      </div>

    </section>

    <!-- Services / Details -->
    <section class="border-t border-neutral-900 pt-16 mb-32">
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-neutral-500 mb-12">Why Collaborate?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-12">
        <div class="border-l border-neutral-800 pl-6">
          <h3 class="font-bold text-xl text-white mb-3">A Careful Process</h3>
          <p class="text-neutral-400 font-light leading-relaxed">
            I take the time to build things properly from the ground up. The focus is on meticulous organization, attention to detail, and reliable delivery.
          </p>
        </div>
        <div class="border-l border-neutral-800 pl-6">
          <h3 class="font-bold text-xl text-white mb-3">Brand-First Results</h3>
          <p class="text-neutral-400 font-light leading-relaxed">
            Every project is approached individually. No templates, no generic formulas, and no cut corners. Visuals are crafted specifically for your audience.
          </p>
        </div>
      </div>
    </section>

    <!-- Call to Action / Footer -->
    <section class="bg-neutral-900/50 border border-neutral-800/60 p-8 md:p-16 rounded-xl max-w-5xl">
      <span class="text-xs font-mono uppercase tracking-[0.2em] text-neutral-500 mb-4 block">Let's connect</span>
      <h2 class="text-3xl md:text-5xl font-black uppercase text-white mb-8 tracking-tight">Have a project in mind?</h2>
      <div class="flex flex-wrap gap-8 text-md md:text-lg font-mono">
        <a href="/contact" class="text-white hover:text-neutral-400 transition-colors uppercase tracking-wider">Contact Form ↗</a>
        <a href="mailto:hello@domain.com" class="text-white hover:text-neutral-400 transition-colors uppercase tracking-wider">Email me ↗</a>
        <a href="#" class="text-white hover:text-neutral-400 transition-colors uppercase tracking-wider">Instagram ↗</a>
      </div>
    </section>
  </main>
</Layout>
