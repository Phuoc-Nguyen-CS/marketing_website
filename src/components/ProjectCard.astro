---
// src/components/ProjectCard.astro
const { project, featured = false } = Astro.props;
const { title, category, thumbnail } = project.data;
const assetBaseUrl = import.meta.env.PUBLIC_ASSET_URL || '';
const fullThumbnailUrl = `${assetBaseUrl}/${thumbnail}`;
---

<a href={`/work/${project.id}`} class="group block overflow-hidden">
  <div class="relative overflow-hidden bg-gray-100 aspect-video mb-6">
    <img 
      src={fullThumbnailUrl} 
      alt={title}
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
  </div>
  
  <div class="flex justify-between items-start">
    <div>
      <h3 class={featured ? "text-4xl font-black tracking-tighter" : "text-xl font-bold tracking-tight"}>
        {title}
      </h3>
      <p class="text-sm uppercase tracking-widest text-gray-400 mt-1">{category}</p>
    </div>
    
    <span class="text-xs font-mono text-gray-300">View Project ↗</span>
  </div>
</a>